# ── Helpers de formatação ─────────────────────────────────────────────────────
def cor_zona(pos: int) -> str:
    if pos <= 5:   return C.BOLD + C.BGREEN
    if pos <= 11:  return C.BOLD + C.CYAN
    if pos >= 17:  return C.BOLD + C.BRED
    return C.WHITE

def badge_zona(pos: int) -> str:
    if pos <= 5:   return C.BOLD + C.BGREEN + "▲" + C.RESET
    if pos <= 11:  return C.BOLD + C.CYAN   + "◆" + C.RESET
    if pos >= 17:  return C.BOLD + C.BRED   + "▼" + C.RESET
    return " "

def str_sg(sg: int) -> str:
    if sg > 0: return C.BGREEN + f"+{sg:>3}" + C.RESET
    if sg < 0: return C.BRED   + f"{sg:>3}"  + C.RESET
    return C.DIM   + f"  0" + C.RESET

def str_forma(forma: list) -> str:
    partes = []
    for r in forma:
        if r == "V": partes.append(C.BOLD + C.GREEN  + "V" + C.RESET)
        elif r == "E": partes.append(C.BOLD + C.YELLOW + "E" + C.RESET)
        else:          partes.append(C.BOLD + C.RED    + "D" + C.RESET)
    return " ".join(partes)

def separador(char="─", largura=120) -> str:
    return C.DIM + char * largura + C.RESET

def colunar(texto, largura, alinhar="left") -> str:
    """Retorna texto truncado/preenchido sem contar códigos ANSI."""
    limpo = ""
    dentro_esc = False
    for ch in texto:
        if ch == "\033":
            dentro_esc = True
        if not dentro_esc:
            limpo += ch
        if dentro_esc and ch == "m":
            dentro_esc = False
    tamanho = len(limpo)
    pad = max(0, largura - tamanho)
    if alinhar == "right":
        return " " * pad + texto
    elif alinhar == "center":
        lpad = pad // 2
        rpad = pad - lpad
        return " " * lpad + texto + " " * rpad
    return texto + " " * pad


